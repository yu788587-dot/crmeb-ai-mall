{
  "uid": "crmeb-ai-overview",
  "title": "AI 链路总览（crmeb-ai-mall）",
  "tags": ["crmeb-ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "ai-service（FastAPI 进程内指标）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP QPS（按端点）",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (endpoint) (rate(ai_http_requests_total[1m]))", "legendFormat": "{{endpoint}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "chat 接口延迟分位数（P50/P95/P99）",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ai_http_duration_seconds_bucket{endpoint=\"chat\"}[5m])))", "legendFormat": "P50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_http_duration_seconds_bucket{endpoint=\"chat\"}[5m])))", "legendFormat": "P95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(ai_http_duration_seconds_bucket{endpoint=\"chat\"}[5m])))", "legendFormat": "P99" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM 调用速率（按结果）",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (kind, outcome) (rate(ai_llm_requests_total[1m]))", "legendFormat": "{{kind}}/{{outcome}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token 消耗速率（按方向）",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (direction) (rate(ai_llm_tokens_total[1m]))", "legendFormat": "{{direction}}" }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "PHP 链路（ai_call_log exporter）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "AI 调用结果速率（成功/静默/降级话术/拒绝/异常）",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(ai_php_outcome_total[1m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "PHP 总延迟分位数（job 全程）",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ai_php_total_ms_bucket[5m])))", "legendFormat": "P50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_php_total_ms_bucket[5m])))", "legendFormat": "P95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(ai_php_total_ms_bucket[5m])))", "legendFormat": "P99" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "队列积压（think-queue LLEN）",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "ai_php_queue_depth", "legendFormat": "待处理任务" }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "可靠性（熔断 / 降级 / 背压）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 21,
      "type": "stat",
      "title": "LLM 熔断器状态（0=closed 1=half_open 2=open）",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "color": "green" }, "1": { "text": "half_open", "color": "yellow" }, "2": { "text": "open", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "ai_circuit_breaker_state{breaker=\"llm\"}" }]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "降级速率（按原因，PHP 侧）",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (rate(ai_php_degraded_total[5m]))", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "背压拒绝速率（ai-service 503 + PHP 派发拒绝）",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (endpoint) (rate(ai_queue_rejected_total[5m]))", "legendFormat": "ai-service/{{endpoint}}" },
        { "refId": "B", "expr": "sum (rate(ai_php_outcome_total{outcome=\"rejected\"}[5m]))", "legendFormat": "php/dispatch" }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "RAG 命中率 与 重试率",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum (rate(ai_php_kb_used_total[5m])) / sum (rate(ai_php_outcome_total{outcome=\"success\"}[5m]))", "legendFormat": "RAG 命中率" },
        { "refId": "B", "expr": "clamp_min(sum (rate(ai_php_http_attempts_total[5m])) / sum (rate(ai_php_outcome_total[5m])) - 1, 0)", "legendFormat": "PHP 重试率" }
      ]
    }
  ]
}
