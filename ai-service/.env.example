# AI 微服务本地运行配置模板
# 复制为 .env 后填入真实值；.env 已 gitignore，绝不提交

APP_NAME=crmeb-ai-service
APP_VERSION=1.0.0
ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------- 模型提供方 ----------
# siliconflow = 真实调用（需填下方 API Key）
# fake = 零网络离线模式，用于单测与演示
LLM_PROVIDER=fake

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL=deepseek-ai/DeepSeek-V3
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
CHAT_MAX_TOKENS=600
CHAT_TEMPERATURE=0.3

# fake 提供方专用：故障注入（窗口 4 演练用）
FAKE_FAIL_MODE=none
FAKE_LATENCY_MS=0

# ---------- 超时 / 重试 / 熔断 ----------
CONNECT_TIMEOUT_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=15.0
SLA_SECONDS=20.0
RETRY_MAX_ATTEMPTS=1
RETRY_BACKOFF_SECONDS=0.2

BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=30.0
BREAKER_HALF_OPEN_MAX_CALLS=2

# ---------- 背压 ----------
MAX_INFLIGHT=8
MAX_QUEUE=32

# ---------- 幂等 ----------
IDEMPOTENCY_TTL_SECONDS=600
IDEMPOTENCY_MAX_ENTRIES=4096

# ---------- 知识库 / RAG ----------
KB_ENABLED=true
KB_COLLECTION=crmeb_kb
KB_DIR=./data/chroma
KB_TOP_K=4
KB_MIN_SCORE=0.25
KB_SYNC_LIMIT_PRODUCTS=500

# MySQL（CRMEB 只读连接，窗口 3 PHP 侧同库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33061
MYSQL_USER=crmeb
MYSQL_PASSWORD=123456
MYSQL_DATABASE=crmeb
MYSQL_PREFIX=eb_
MYSQL_CONNECT_TIMEOUT=3
MYSQL_READ_ONLY=true

# ---------- 降级话术 ----------
FALLBACK_TEXT=抱歉，当前智能客服暂时不可用，您可以换个说法再问一次，或等待人工客服回复。
NO_ANSWER_TEXT=这个问题我在商品和客服资料里没有找到依据，为避免误导，建议联系人工客服确认。

# ---------- 可观测 ----------
METRICS_ENABLED=true
METRICS_PATH=/metrics
